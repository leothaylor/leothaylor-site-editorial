---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialNoteCard from '../../components/EditorialNoteCard.astro';
import '../../styles/aps-proposals.css';
import '../../styles/notes-editorial.css';

const base = import.meta.env.BASE_URL;
const notes = (await getCollection('notes'))
  .filter((note) => note.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.order - b.data.order);
---
<BaseLayout title="Notas · Leo Thaylor" description="Hipóteses, perguntas e ideias.">
  <section class="notes-index-hero section-pad reveal">
    <span class="eyebrow">NOTAS</span>
    <h1>Hipóteses, perguntas e ideias</h1>
  </section>

  <section class="section-pad section-pad--topless">
    {notes.length > 0 && (
      <div class="editorial-note-list">
        {notes.map((note) => <EditorialNoteCard note={note} />)}
      </div>
    )}

    <a class="aps-notes-feature reveal" href={`${base}notas/propostas-melhoria-aps/`} aria-label="Abrir coleção Propostas de melhoria na APS">
      <div><span class="aps-notes-feature__kicker">ARQUIVO DE TRABALHO · APS</span></div>
      <div>
        <h2>Propostas de melhoria na APS.</h2>
        <p>Reuni três trabalhos que desenvolvi enquanto trabalhava em uma Clínica da Família. Em cada um, tento mostrar o problema que eu via, o que eu desenhei ou produzi e até onde a proposta realmente chegou, sem transformar projeto não implementado em resultado.</p>
        <span class="aps-collection-card__link">Abrir coleção →</span>
      </div>
    </a>
  </section>
</BaseLayout>
