---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Página não encontrada · Leo Thaylor">
  <section class="empty-state section-pad">
    <span class="eyebrow">404</span>
    <h1>Essa página não existe.</h1>
    <p>Você pode voltar para o início, abrir os projetos ou ir para as notas.</p>
    <a class="button" href={base}>Voltar ao início →</a>
  </section>
</BaseLayout>
